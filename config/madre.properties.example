# The CORE role is an ordinary registered Module identity.
roles.core=io.github.didacll.madre.owner-interaction
kernel.database=var/kernel-work.sqlite
kernel.result-retention-seconds=86400
module.owner-interaction.state=var/owner-interaction-background.state

# Explicit physical capacity and connector claims.
resources.model-slot=1
resources.network-slot=4

# Preferred same-host llama-server transport on systems with Unix-domain sockets.
# Start llama-server with an owner-only absolute socket path ending in .sock. This
# adapter creates no TCP listener and has higher preference than the HTTP fallback.
connector.llamacpp-unix.enabled=false
connector.llamacpp-unix.id=local-llama-uds
connector.llamacpp-unix.socket=/absolute/path/madre-runtime/llama-server.sock
connector.llamacpp-unix.model=local-model
connector.llamacpp-unix.privacy=P5
connector.llamacpp-unix.integrity=I5
connector.llamacpp-unix.expected-latency-ms=30000
connector.llamacpp-unix.preference=200
connector.llamacpp-unix.resource.model-slot=1

# Loopback HTTP compatibility adapter. Keep llama-server bound to a loopback
# interface; never expose owner-local inference via 0.0.0.0 merely for integration.
connector.llamacpp.enabled=true
connector.llamacpp.id=local-llama-http
connector.llamacpp.endpoint=http://127.0.0.1:8080/
connector.llamacpp.model=local-model
connector.llamacpp.privacy=P5
connector.llamacpp.integrity=I5
connector.llamacpp.expected-latency-ms=30000
connector.llamacpp.preference=100
connector.llamacpp.resource.model-slot=1

# Optional unauthenticated OpenAI-compatible endpoint. Account/session mechanics are external.
connector.openai-compatible.enabled=false
connector.openai-compatible.id=compatible-text
connector.openai-compatible.endpoint=http://127.0.0.1:8081/v1/
connector.openai-compatible.model=compatible-model
connector.openai-compatible.privacy=P5
connector.openai-compatible.integrity=I5
connector.openai-compatible.location=LOCAL
connector.openai-compatible.expected-latency-ms=30000
connector.openai-compatible.preference=50

# Optional SearXNG JSON search endpoint. The receiving Privacy and Integrity are
# installation facts; endpoint locality never derives either value.
connector.searxng.enabled=false
connector.searxng.id=web-search
connector.searxng.endpoint=http://127.0.0.1:8888/search
connector.searxng.privacy=P2
connector.searxng.integrity=I2
connector.searxng.expected-latency-ms=5000
connector.searxng.preference=100
connector.searxng.resource.network-slot=1
