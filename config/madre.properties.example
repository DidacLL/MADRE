# CORE is optional and is only an ordinary installed Module identity. Remove this line
# to run with no CORE assignment.
roles.core=io.github.didacll.madre.owner-interaction
kernel.database=var/kernel-work.sqlite
kernel.result-retention-seconds=86400
modules.state-directory=var/module-state
# Installed distributions discover Module JARs from their sibling modules/ directory by default.
# modules.directory=/absolute/path/to/madre-modules
# Reasoning mechanisms are discovered independently from sibling reasoning/ JARs by default.
# reasoning.directory=/absolute/path/to/madre-reasoning

# Optional local text presentation binding. This is madre-app installation policy over one ordinary
# installed Module and is independent of roles.core. Remove all interaction.* lines for the generic
# low-level console. The configured default Sensitivity is explicit; it is never inferred from text.
interaction.module=io.github.didacll.madre.owner-interaction
interaction.default-operation=fast-lane
interaction.standard-operation=standard-prompt
interaction.prompt-material-type=owner-prompt
interaction.default-sensitivity=S5
interaction.updates-operation=collect-background
interaction.updates-material-type=background-collection-request
interaction.updates-payload=collect
interaction.updates-sensitivity=S1

# Explicit resource capacity for reasoning mechanisms. The reasoning directory may be absent
# or empty, and every installed provider may remain disabled; MADRE still boots.
resources.model-slot=1

# Provider-owned configuration supports multiple named AF_UNIX llama.cpp instances.
# Merely installing the adapter JAR never enables an instance.
reasoning.llamacpp-unix.instances=primary
reasoning.llamacpp-unix.primary.enabled=false
reasoning.llamacpp-unix.primary.id=local-llama-uds
reasoning.llamacpp-unix.primary.socket=/absolute/path/madre-runtime/llama-server.sock
reasoning.llamacpp-unix.primary.model=local-model
reasoning.llamacpp-unix.primary.privacy=SECRET
reasoning.llamacpp-unix.primary.expected-latency-ms=30000
reasoning.llamacpp-unix.primary.preference=200
reasoning.llamacpp-unix.primary.resource.model-slot=1

# Explicit loopback-HTTP llama.cpp compatibility instance.
reasoning.llamacpp-http.instances=compat
reasoning.llamacpp-http.compat.enabled=false
reasoning.llamacpp-http.compat.id=local-llama-http
reasoning.llamacpp-http.compat.endpoint=http://127.0.0.1:8080/
reasoning.llamacpp-http.compat.model=local-model
reasoning.llamacpp-http.compat.privacy=SECRET
reasoning.llamacpp-http.compat.expected-latency-ms=30000
reasoning.llamacpp-http.compat.preference=100
reasoning.llamacpp-http.compat.resource.model-slot=1

# Optional OpenAI-compatible instances. Account/session mechanics remain external.
# Privacy is always explicit and is never inferred from endpoint or ReasoningLocation.
reasoning.openai-compatible.instances=example
reasoning.openai-compatible.example.enabled=false
reasoning.openai-compatible.example.id=compatible-text
reasoning.openai-compatible.example.endpoint=http://127.0.0.1:8081/v1/
reasoning.openai-compatible.example.model=compatible-model
reasoning.openai-compatible.example.privacy=SECRET
reasoning.openai-compatible.example.location=LOCAL
reasoning.openai-compatible.example.expected-latency-ms=30000
reasoning.openai-compatible.example.preference=50
